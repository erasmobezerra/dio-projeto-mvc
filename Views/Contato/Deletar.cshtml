@model projeto_mvc.Models.Contato

@{
    ViewData["Title"] = "Deletar Contato";
}

<h3 style="color: red;">Deseja deletar este contato? Essa operação é irreversível.</h3>

<div>
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Ativo)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Ativo)
        </dd>
    </dl>
</div>

<form asp-action="Deletar" method="post">    
    <input type="submit" value="Deletar" class="btn btn-danger" /> 
</form>

<br />
<a asp-action="Index" class="btn btn-secondary">Voltar</a>